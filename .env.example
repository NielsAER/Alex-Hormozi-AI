# Kopieer dit bestand naar .env en vul de waarden in.
# Docker Compose leest dit bestand automatisch.

# --- Verplicht ---

# Anthropic API key (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Voyage AI API key (embeddings) — https://www.voyageai.com/
VOYAGE_API_KEY=

# --- Optioneel (Docker) ---

# Wachtwoord voor de PostgreSQL-container (standaard: postgres).
# POSTGRES_PASSWORD=kies-een-sterk-wachtwoord

# --- Alleen nodig ZONDER Docker (lokale dev / eigen database) ---

# PostgreSQL met pgvector. Bij Docker Compose wordt dit automatisch gezet;
# laat het dan leeg.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hormozi

# Zet op true als je database SSL vereist (bijv. een managed database).
# DATABASE_SSL=false

# Poort voor de backend (standaard 3001).
# PORT=3001
