# Kopieer dit bestand naar .env (of stel de variabelen in via Replit Secrets).

# Anthropic API key (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API key (embeddings) — https://platform.openai.com/
OPENAI_API_KEY=

# PostgreSQL met pgvector. Op Replit wordt DATABASE_URL automatisch ingevuld
# zodra je een PostgreSQL-database aan je Repl toevoegt.
DATABASE_URL=

# Optioneel: poort voor de backend (standaard 3001).
# PORT=3001
